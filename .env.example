# ============================================================================
# AI Marketing Team Copilot & Client Hub - Environment Variables
# ============================================================================

# 1. Google Gemini API Key (Required for Live AI Copilot, Task Splitter & KPI Evaluator)
GEMINI_API_KEY="your_google_gemini_api_key_here"
NEXT_PUBLIC_GEMINI_MODEL="gemini-2.0-flash"

# 2. Supabase Configuration (PostgreSQL + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
